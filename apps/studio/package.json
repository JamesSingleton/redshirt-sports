    "@sanity/debug-live-sync-tags": "1.0.21",
    "@sanity/icons": "^5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/sanity-plugin-async-list": "3.1.0",
    "@sanity/ui": "^4.4.10",
