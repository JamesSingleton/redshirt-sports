# apps/studio/.env.local.example: LOCAL VALUES ONLY (copy to apps/studio/.env.local)
# Studio runs locally (pnpm --filter @redshirt-sports/studio dev → http://localhost:3333) against the DEVELOPMENT dataset.
SANITY_STUDIO_PROJECT_ID="<project id>"
SANITY_STUDIO_DATASET="development"
SANITY_STUDIO_PREVIEW_URL="http://localhost:3000"
SCHOOL_SYNC_URL="http://localhost:3000/api/webhooks/sanity/school"
