{
  "installCommand": "pnpm install --filter @redshirt-sports/web...",
  "ignoreCommand": "npx --yes turbo@^2.11.10 query affected --packages @redshirt-sports/web --base \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^1}\" --exit-code",
  "crons": [
    { "path": "/api/cron/ratings", "schedule": "*/30 16-23 * * 6" },
    { "path": "/api/cron/ratings", "schedule": "*/30 0-11 * * 0" },
    { "path": "/api/cron/ratings", "schedule": "*/30 22-23 * * 1" },
    { "path": "/api/cron/ratings", "schedule": "*/30 0-7 * * 2" },
    { "path": "/api/cron/rankings", "schedule": "0 14 * * 1" },
    { "path": "/api/cron/rankings", "schedule": "0 15 * * 1" }
  ]
}
