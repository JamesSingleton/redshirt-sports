{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --filter @redshirt-sports/web...",
  "ignoreCommand": "npx --yes turbo@^2.11.10 query affected --packages @redshirt-sports/web --base \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^1}\" --exit-code",
  "schedules": {
    "ratings-sunday-overnight": {
      "schedule": "0 0 * 8-12,1 0",
      "timezone": "America/Los_Angeles",
      "path": "/api/cron/ratings",
      "requestMethod": "GET"
    },
    "ratings-sunday-morning": {
      "schedule": "0 6 * 8-12,1 0",
      "timezone": "America/New_York",
      "path": "/api/cron/ratings",
      "requestMethod": "GET"
    },
    "ratings-tuesday-morning": {
      "schedule": "0 6 * 8-12,1 2",
      "timezone": "America/New_York",
      "path": "/api/cron/ratings",
      "requestMethod": "GET"
    },
    "rankings-monday-14utc": {
      "schedule": "0 14 * * 1",
      "path": "/api/cron/rankings",
      "requestMethod": "GET"
    },
    "rankings-monday-15utc": {
      "schedule": "0 15 * * 1",
      "path": "/api/cron/rankings",
      "requestMethod": "GET"
    }
  }
}
