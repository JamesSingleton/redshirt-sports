# apps/web/.env.local.example: LOCAL VALUES ONLY (copy to apps/web/.env.local; `pnpm dev:setup` does it for you)
# Never paste production values here. Never `vercel env pull`. Check with: node scripts/assert-local-env.mjs
# Note: this does not replace the repo's existing apps/web/.env.example (the variable inventory); it fills it with local values.

NEXT_PUBLIC_APP_NAME="Redshirt Sports (local)"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database: local Supabase (supabase start --workdir apps/web) ─────────────
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
LOCAL_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
POSTGRES_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
POSTGRES_PRISMA_URL=""
POSTGRES_HOST="127.0.0.1"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# Paste the LOCAL keys printed by `supabase status --workdir apps/web` (they are local-only demo keys)
SUPABASE_ANON_KEY="<local anon/publishable key from supabase status>"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<local anon/publishable key from supabase status>"
SUPABASE_SERVICE_ROLE_KEY="<local service_role/secret key from supabase status>"
SUPABASE_JWT_SECRET="<local JWT secret from supabase status>"
# Must stay EMPTY in Cursor sessions (production dump is a James-only, manual task)
PROD_DATABASE_URL=""

# ── Sanity: development dataset only ─────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID="<project id>"
SANITY_API_PROJECT_ID="<project id>"
NEXT_PUBLIC_SANITY_DATASET="development"
SANITY_API_DATASET="development"
NEXT_PUBLIC_SANITY_API_VERSION="2026-06-12"
# Viewer (read) token, server-only; use a token James creates for local dev
SANITY_API_READ_TOKEN=""
SANITY_REVALIDATE_SECRET="local-sanity-revalidate-secret"

# ── Clerk: DEVELOPMENT instance keys only (pk_test_/sk_test_) ────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_WITH_DEV_INSTANCE_KEY"
CLERK_SECRET_KEY="sk_test_REPLACE_WITH_DEV_INSTANCE_KEY"
# From the dev instance webhook endpoint (pointed at a local tunnel → http://localhost:3000/api/webhooks/auth)
CLERK_WEBHOOK_SECRET="whsec_local_dev_placeholder"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ── Webhooks / revalidation: local targets only ──────────────────────────────
CACHE_REVALIDATE_SECRET="local-cache-revalidate-secret"
SCHOOL_SYNC_SECRET="local-school-sync-secret"
SCHOOL_SYNC_URL="http://localhost:3000/api/webhooks/sanity/school"

# ── Upstash Redis: local Redis behind serverless-redis-http (see LOCAL_DEVELOPMENT.md) ─
UPSTASH_REDIS_REST_URL="http://127.0.0.1:8079"
UPSTASH_REDIS_REST_TOKEN="local_srh_token"

# ── Email: Resend test mode or local preview ─────────────────────────────────
# preview      = render with React Email, write HTML to .local-email/, send nothing (default)
# resend-test  = Resend API with a test key; only send to delivered@resend.dev / bounced@resend.dev
EMAIL_TRANSPORT="preview"
RESEND_API_KEY=""
EMAIL_TEST_RECIPIENT="delivered@resend.dev"

# ── Analytics / observability: off locally ───────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
SENTRY_DSN=""
SKIP_ENV_VALIDATION="false"
