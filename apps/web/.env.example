# --- App ---
NEXT_PUBLIC_APP_NAME="Redshirt Sports"
# Canonical production hostname (used on Vercel production). Local dev uses http://localhost:3000.
NEXT_PUBLIC_SITE_URL="www.redshirtsports.xyz"

# --- Sanity ---
NEXT_PUBLIC_SANITY_API_VERSION="2026-06-12"
SANITY_API_PROJECT_ID=""
SANITY_STUDIO_PROJECT_ID=""
NEXT_PUBLIC_SANITY_PROJECT_ID=""
SANITY_API_DATASET=""
SANITY_STUDIO_DATASET=""
NEXT_PUBLIC_SANITY_DATASET=""
SANITY_API_READ_TOKEN=""
SANITY_API_WRITE_TOKEN=""
SANITY_REVALIDATE_SECRET=""
SANITY_STUDIO_URL="http://localhost:3333"

# --- Cron (optional fallback; admin finalize is the primary path) ---
CRON_SECRET=""

# --- Clerk (cloud is fine for local; keep DB local) ---
CLERK_WEBHOOK_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# --- Analytics / Redis ---
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
UPSTASH_REDIS_REST_TOKEN=""
UPSTASH_REDIS_REST_URL=""

# =============================================================================
# Postgres / Supabase — LOCAL DEVELOPMENT
# =============================================================================
# NEVER put production database credentials in .env.local.
# Start local Supabase from apps/web: `pnpm db:local:start`
# Then set DATABASE_URL from `pnpm db:local:status` (default below).
#
# Default local connection (supabase/config.toml db.port = 54322):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
#
# Optional Supabase local API keys (from `pnpm db:local:status`):
SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""
#
# Legacy / Vercel-style aliases (optional; app uses DATABASE_URL via @redshirt-sports/db/keys):
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT="54322"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
