{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "admin",
      "url": "http://localhost:3001",
      "port": 3001
    },
    {
      "name": "web (start dev server)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web (production build)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "admin (start dev server)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "admin",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "studio (start dev server)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@redshirt-sports/studio",
        "dev"
      ],
      "port": 3333
    }
  ]
}
