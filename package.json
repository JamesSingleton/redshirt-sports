{
  "name": "@redshirt-sports/root",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "biome format --write .",
    "check:format": "biome check .",
    "check:types": "turbo run check:types",
    "ci": "turbo run lint check:types test --affected",
    "db:sync-from-prod": "pnpm --filter @redshirt-sports/db db:sync-from-prod",
    "ratings": "pnpm --filter @redshirt-sports/db ratings",
    "blueprints:plan": "pnpm dlx sanity@latest blueprints plan",
    "blueprints:deploy": "pnpm dlx sanity@latest blueprints deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@redshirt-sports/typescript-config": "workspace:*",
    "@sanity/blueprints": "^0.34.1",
    "turbo": "^2.11.13",
    "typescript": "catalog:"
  }
}
